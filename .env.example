# Axentra Vehicles — frontend environment template.
# Copy to `.env` and fill in. NEVER commit the real `.env` (it is gitignored).
#
# These VITE_* values are bundled into the client build and are therefore PUBLIC.
# Only the Supabase *publishable* (anon) key belongs here — never the service-role key.

# Supabase project ref / id (from the Supabase dashboard)
VITE_SUPABASE_PROJECT_ID=""

# Supabase publishable (anon) key — safe to expose to the browser.
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Supabase REST/Auth base URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=""

# In production, auth is ALWAYS enforced regardless of this flag.
# Setting "false" only disables auth in local `vite` dev mode.
VITE_ENABLE_AUTH="true"

# NOTE: VITE_SUPERADMIN_EMAILS has been removed — it was unused in the app and
# leaked the superadmin email list. Super-admin is determined solely by the
# `user_profiles.role` column on the server. Do not reintroduce it.
